SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
SESSION_SECRET=generate-with-openssl-rand-hex-32
DEMO_EMAIL=demo.owner@example.com
DEMO_PASSWORD=
DEMO_TENANT_NAME=Demo Company

# Optional AI agents. Leave AI_API_KEY empty to run every agent deterministically.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_SMALL=gpt-4o-mini
AI_MODEL_LARGE=gpt-4o
AI_TIMEOUT_MS=45000

# Optional metadata-only tracing (no document or chat text is sent).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public base URL of this app. Used for OAuth callbacks and links.
APP_BASE_URL=http://localhost:3000

# 32-byte key (64 hex chars) that encrypts Google OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Tally bridge. The signing secret is shared with the agent process.
BRIDGE_SIGNING_SECRET=
BRIDGE_POLL_LIMIT=10

# Authenticates the scheduler that calls GET /api/jobs/run (x-cron-secret or Bearer).
CRON_SECRET=

# Google Sheets OAuth app. Add <APP_BASE_URL>/api/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional GSTIN verification provider. Without it only the format/checksum runs.
GSTIN_API_URL=
GSTIN_API_KEY=

# Optional notification providers.
EMAIL_API_URL=
EMAIL_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional vision model for scanned documents and photos.
AI_VISION_MODEL=gpt-4o
